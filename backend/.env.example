NODE_ENV=development
PORT=4000
FRONTEND_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://dockerpilot:dockerpilot_dev@localhost:5432/dockerpilot?schema=public
JWT_SECRET=replace_with_a_random_secret_at_least_32_characters_long
# Optional Google Sign-In. Set all three values together to enable it.
# Create an OAuth 2.0 Web application client in Google Cloud Console.
# GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your-client-secret
# GOOGLE_OAUTH_REDIRECT_URI=http://localhost:4000/api/auth/google/callback
# Optional override if Dockerode's local default cannot reach Docker Desktop.
# DOCKER_SOCKET_PATH=/path/to/docker.sock
# Use agent mode to route Docker requests through the paired computer; default is direct local access.
# DOCKER_CONNECTION_MODE=agent
# Local agent endpoint used by the Pair This Computer workflow.
DOCKERPILOT_AGENT_API_URL=http://localhost:4000/api
# Generate 32 random bytes and base64 encode them to encrypt private-repository tokens at rest.
# Optional contextual assistant provider. Keep the key only in backend/.env.
# Gemini takes precedence when both provider keys are set.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash-lite
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1
# Smart Auto-Sleep analysis thresholds. Candidates are suggestions only.
AI_IDLE_CPU_THRESHOLD_PERCENT=1
AI_IDLE_IO_THRESHOLD_BYTES=1024
AI_IDLE_MINIMUM_MINUTES=15
